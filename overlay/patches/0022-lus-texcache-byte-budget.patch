     virtual void DeleteTexture(uint32_t texId) = 0;
+    // SOH_IOS (overlay 0022): total bytes of live GPU textures created via
+    // UploadTexture. Backends without accounting report 0, which disables the
+    // interpreter's byte-budget eviction.
+    virtual size_t GetTextureBytes() {
+        return 0;
+    }
     virtual void SetTextureFilter(FilteringMode mode) = 0;
     virtual FilteringMode GetTextureFilter() = 0;
     virtual void SetSrgbMode() = 0;
