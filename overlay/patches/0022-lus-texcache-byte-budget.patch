--- a/libultraship/src/graphic/Fast3D/interpreter.cpp
+++ b/libultraship/src/graphic/Fast3D/interpreter.cpp
@@ -966,6 +966,41 @@
             SPDLOG_ERROR("Invalid texture format. Fmt = {}", fmt);
             break;
     }
+
+#ifdef __IOS__
+    // SOH_IOS (overlay 0022): the count cap alone lets big texture packs pin
+    // gigabytes (entries are up to 16-256 MB each) -> jetsam at menu upload
+    // bursts. Evict LRU entries until under the byte budget. Both
+    // currently-bound tiles were just touched (LRU back), and pending draws
+    // are flushed before imports, so the front is never referenced by
+    // unencoded work.
+    {
+        size_t sohIosBudget = (size_t)CVarGetInteger("gSohIos.TexCacheBudgetMB", 1536) * 1024 * 1024;
+        bool sohIosEvicted = false;
+        while (mRapi->GetTextureBytes() > sohIosBudget && mTextureCache.map.size() > 128) {
+            TextureCacheMap::iterator evictIt = mTextureCache.lru.front().it;
+            mRapi->DeleteTexture(evictIt->second.texture_id);
+            mTextureCache.free_texture_ids.push_back(evictIt->second.texture_id);
+            for (int j = 0; j < SHADER_MAX_TEXTURES; j++) {
+                if (mRenderingState.mTextures[j] == &*evictIt) {
+                    mRenderingState.mTextures[j] = nullptr;
+                }
+            }
+            mTextureCache.map.erase(evictIt);
+            mTextureCache.lru.pop_front();
+            sohIosEvicted = true;
+        }
+        if (sohIosEvicted) {
+            // Rate-limited so heavy streaming can't spam the log.
+            static uint32_t sohIosEvictLogCounter = 0;
+            if ((sohIosEvictLogCounter++ % 200) == 0) {
+                SPDLOG_INFO("texcache: evicted to {} MB / {} entries (budget {} MB)",
+                            mRapi->GetTextureBytes() / (1024 * 1024), mTextureCache.map.size(),
+                            sohIosBudget / (1024 * 1024));
+            }
+        }
+    }
+#endif
 }
 
