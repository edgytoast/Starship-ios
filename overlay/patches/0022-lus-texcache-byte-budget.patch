 void GfxRenderingAPIMetal::DeleteTexture(uint32_t texID) {
+    // SOH_IOS (overlay 0022): this was a no-op, so cache eviction never freed
+    // GPU memory (the MTLTexture lived until its id was reused with different
+    // dims). Command buffers retain in-flight resources, so releasing here is
+    // safe even if the GPU is still reading the texture this frame.
+    if (texID >= mTextures.size()) {
+        return;
+    }
+    TextureDataMetal* t = &mTextures[texID];
+    if (t->texture != nullptr) {
+        // SOH_IOS (overlay 0022 rev2): mip-aware — a full chain (0021 rev2) adds
+        // one third over the base level, matching UploadTexture's accounting.
+        size_t sohIosBytes = (size_t)t->texture->width() * t->texture->height() * 4;
+        if (t->texture->mipmapLevelCount() > 1) {
+            sohIosBytes += sohIosBytes / 3;
+        }
+        mTextureBytes -= sohIosBytes;
+        t->texture->release();
+        t->texture = nullptr;
+    }
+    if (t->msaaTexture != nullptr) {
+        t->msaaTexture->release();
+        t->msaaTexture = nullptr;
+    }
+}
+
+size_t GfxRenderingAPIMetal::GetTextureBytes() {
+    return mTextureBytes;
 }
 
