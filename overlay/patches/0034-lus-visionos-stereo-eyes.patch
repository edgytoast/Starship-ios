+#ifdef __IOS__
+// SOH_IOS (overlay 0034): eye-pass control. SetEye(1|2) swaps mGameFb to the
+// eye's framebuffer (created lazily); SetEye(0) restores 2D state.
+void Interpreter::Soh3DSetEye(int eye) {
+    if (eye == 0) {
+        if (mSoh3DSavedGameFb >= 0) {
+            mGameFb = mSoh3DSavedGameFb;
+        }
+        if (mSoh3DSavedW > 0) {
+            mCurDimensions.width = mSoh3DSavedW;
+            mCurDimensions.height = mSoh3DSavedH;
+            mCurDimensions.aspect_ratio = mSoh3DSavedAspect;
+        }
+        sSoh3DEye = 0;
+        return;
+    }
+    if (mSoh3DEyeFb[0][0] < 0) {
+        for (int sohE = 0; sohE < 2; sohE++) {
+            for (int sohB = 0; sohB < 2; sohB++) {
+                mSoh3DEyeFb[sohE][sohB] = mRapi->CreateFramebuffer();
+            }
+        }
+    }
+    if (eye == 1) {
+        mSoh3DPing ^= 1;
+    }
+    if (sSoh3DEye == 0) {
+        mSoh3DSavedGameFb = mGameFb;
+        mSoh3DSavedW = mCurDimensions.width;
+        mSoh3DSavedH = mCurDimensions.height;
+        mSoh3DSavedAspect = mCurDimensions.aspect_ratio;
+    }
+    // Adaptive convergence: zero-parallax anchored on the camera's live focus
+    // distance (0035, smoothed) so the subject sits ON the panel in every scene
+    // and background disparity is constant. SF64 rail sections have near-
+    // constant camDist -> rock solid; retune 0.08 vs bridge `3d` camDist.
+    if (eye == 1) {
+        float sohCamD = gSoh3DCamDist;
+        if (!(sohCamD >= 30.0f && sohCamD <= 30000.0f)) {
+            sohCamD = 300.0f;
+        }
+        sSoh3DConvSmooth += (sohCamD - sSoh3DConvSmooth) * 0.08f;
+        float sohStereoOn = (gSoh3DPaused || !gSoh3DInPlay) ? 0.0f : 1.0f;
+        sSoh3DPauseMix += (sohStereoOn - sSoh3DPauseMix) * 0.15f;
+        if (sSoh3DPauseMix < 0.02f) {
+            sSoh3DPauseMix = 0.0f;
+        }
+        sSoh3DAimMix += ((gSoh3DAiming ? 1.0f : 0.0f) - sSoh3DAimMix) * 0.15f;
+        sSoh3DCineMix += ((gSoh3DCinematic ? 1.0f : 0.0f) - sSoh3DCineMix) * 0.10f;
+    }
+    auto sohCvars = Ship::Context::GetInstance()->GetConsoleVariables();
+    float sohDepth = sohCvars->GetFloat("gSohIos.StereoDepth", 0.025f);
+    float sohBias = sohCvars->GetFloat("gSohIos.StereoConvBias", 1.0f);
+    // Round 2 user-tunable RELATIVE depth: the Arwing (per-object, applied via
+    // the 0x5C/0x5D sentinels) and cinematics (whole-scene, smoothed by
+    // sSoh3DCineMix). Both are fractions of the general depth — 1.0 = same,
+    // 0.0 = flat. lerp so the cinematic reduction eases in/out.
+    sSoh3DPlayerDepthFrac = sohCvars->GetFloat("gSohIos.StereoPlayerDepthMul", 0.35f);
+    float sohCineFrac = sohCvars->GetFloat("gSohIos.StereoCinematicMul", 0.4f);
+    float sohCineDepthMul = 1.0f - (1.0f - sohCineFrac) * sSoh3DCineMix;
+    float sohAimDepthMul = 1.0f - 0.7f * sSoh3DAimMix;
+    float sohAimBiasMul = 1.0f - 0.5f * sSoh3DAimMix;
+    sSoh3DConv = sSoh3DConvSmooth * sohBias * sohAimBiasMul;
+    sSoh3DSep = sohDepth * sohAimDepthMul * sohCineDepthMul * sSoh3DConv;
+    gSoh3DDbgConv = sSoh3DConv;
+    gSoh3DDbgSep = sSoh3DSep;
+    mGameFb = mSoh3DEyeFb[eye - 1][mSoh3DPing];
+    sSoh3DEye = eye;
+}
+
+int Interpreter::Soh3DGetEyeFb(int eye) {
+    return (eye >= 1 && eye <= 2) ? mSoh3DEyeFb[eye - 1][mSoh3DPing] : -1;
+}
+
+void Interpreter::Soh3DEndEyePass(int eye) {
+    if (eye >= 1 && eye <= 2 && mSoh3DEyeFb[eye - 1][mSoh3DPing] >= 0) {
+        mRapi->Soh3DPublishOnComplete(mSoh3DEyeFb[eye - 1][mSoh3DPing], eye - 1);
+    }
+    mRapi->EndFrameOffscreen();
+    mRapi->FinishRender();
+    if (eye >= 1 && eye <= 2) {
+        gSoh3DEyeFrames[eye - 1] = gSoh3DEyeFrames[eye - 1] + 1;
+    }
 }
+#endif
 
