+static int sSoh3DEye = 0;
+static float sSoh3DSep = 3.0f;
+static float sSoh3DConv = 300.0f;
+static float sSoh3DConvSmooth = 300.0f;
+static float sSoh3DPauseMix = 1.0f;
+static float sSoh3DAimMix = 0.0f;
+static int sSoh3DSkybox = 0;
+// SOH_IOS (overlay 0034, device round 2): per-object separation scale, driven
+// by DL sentinels 0x5C/0x5D around the player Arwing (fox_display.c, 0035) so
+// the near ship pops less without flattening the scene. Target fraction +
+// smoothed cinematic reduction are CVar-backed (read in Soh3DSetEye).
+static float sSoh3DObjSepMul = 1.0f;
+static float sSoh3DPlayerDepthFrac = 0.35f;
+static float sSoh3DCineMix = 0.0f;
+static float sSoh3DP[4][4];
+// Off-axis stereo for the COMBINED viewing*projection (SF64 composes
+// guPerspective*Matrix_LookAt in the projection slot). Camera axes come from
+// the game's export (0035). Camera shift: world translation -e*right folded in.
+// Convergence skew: clip_x += s*view_z, s = e*P00/C, zero parallax at the focus.
+// Perspective detect: the combined matrix's w-column top-3 is (+/-)forward.
+static void Soh3DStereoP(float out[4][4], const float in[4][4]) {
+    memcpy(out, in, sizeof(sSoh3DP));
+    float sohWx = in[0][3], sohWy = in[1][3], sohWz = in[2][3];
+    if (sohWx * sohWx + sohWy * sohWy + sohWz * sohWz < 0.25f) {
+        if (sSoh3DSkybox && sSoh3DEye != 0) {
+            const float sohE = (sSoh3DEye == 2 ? 1.0f : -1.0f) * 0.5f * sSoh3DSep * sSoh3DPauseMix;
+            if (sohE != 0.0f && sSoh3DConv > 0.0f) {
+                out[3][0] += (sohE * gSoh3DCamP00 / sSoh3DConv) * out[3][3];
+            }
+        }
+        return;
+    }
+    // sSoh3DObjSepMul (1.0 except between the Arwing sentinels) scales BOTH the
+    // camera-shift and the convergence skew below, so the ship's disparity
+    // shrinks uniformly — no depth-fighting within the model.
+    const float e = (sSoh3DEye == 2 ? 1.0f : -1.0f) * 0.5f * sSoh3DSep * sSoh3DPauseMix * sSoh3DObjSepMul;
+    if (e == 0.0f) {
+        return;
+    }
+    // round-3 verify: count perspective folds that ran while INSIDE the Arwing
+    // sentinel bracket (objSepMul != 1). If arwingHits climbs but this stays 0,
+    // no ship matrix loads between the sentinels -> the reduction never reaches
+    // the ship's vertices.
+    if (sSoh3DObjSepMul != 1.0f) {
+        gSoh3DDbgObjFold = gSoh3DDbgObjFold + 1;
+    }
+    if (!sSoh3DSkybox) {
+        const float dx = -e * gSoh3DCamRight[0];
+        const float dy = -e * gSoh3DCamRight[1];
+        const float dz = -e * gSoh3DCamRight[2];
+        for (int j = 0; j < 4; j++) {
+            out[3][j] += dx * out[0][j] + dy * out[1][j] + dz * out[2][j];
+        }
+    }
+    const float s = e * gSoh3DCamP00 / sSoh3DConv;
+    const float sohEyeF = gSoh3DCamEye[0] * gSoh3DCamFwd[0] + gSoh3DCamEye[1] * gSoh3DCamFwd[1] +
+                          gSoh3DCamEye[2] * gSoh3DCamFwd[2];
+    out[0][0] += s * gSoh3DCamFwd[0];
+    out[1][0] += s * gSoh3DCamFwd[1];
+    out[2][0] += s * gSoh3DCamFwd[2];
+    out[3][0] += s * -sohEyeF;
 }
+#endif
 
